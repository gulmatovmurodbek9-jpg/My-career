# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real credentials.

# ── PostgreSQL ──
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_database_password
DB_NAME=career_db

# ── AI providers (optional — the app falls back gracefully without them) ──
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key

# ── Server ──
PORT=3005
JWT_SECRET=generate_a_long_random_string_here

# Vertex AI (реҷаи express — калиди оддии API, бе ҳисоби хизматӣ).
# Талаб мекунад, ки aiplatform.googleapis.com дар лоиҳа фаъол бошад.
# Агар холӣ монад ё API фаъол набошад, код бесадо ба GEMINI_API_KEY мегузарад.
VERTEX_API_KEY=
VERTEX_MODEL=gemini-flash-latest

# Лимити рӯзонаи саволҳои AI барои як корбар.
# Холӣ ё 0 = бе лимит (ҳолати ҳозира). Барои баргардонидан: AI_DAILY_LIMIT=5
AI_DAILY_LIMIT=
