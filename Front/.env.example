# Copy this file to .env and adjust if your backend runs elsewhere.
VITE_API_URL=http://localhost:3005/api

# Client ID барои вуруд тавассути Google.
# Ҳамон қиматест, ки дар Back/nest-backend/.env ҳамчун GOOGLE_CLIENT_ID аст.
# Агар холӣ бошад, тугмаи Google дар саҳифаҳои вуруд/бақайдгирӣ намоён намешавад.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
